    "#Exception Handling\n",
    "#Write a program that asks the user for a number and handles invalid input.\n",
    "try:\n",
    "    number = int(input(\"enter  a number:  \",))\n",
    "    print(\"number\")\n",
    "finally:\n",
    "    print(\"invalid input. please enter a whole number.\")\n"
   ]
